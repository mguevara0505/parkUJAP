# ─────────────────────────────────────────────────────────
# UJAP Parking — Producción (plantilla)
#
# Copiar como `.env` en el servidor y rellenar los valores reales.
# `.env` está en .gitignore: NUNCA se sube con secretos dentro.
#
# Los secretos se generan, no se inventan:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# ── Base de datos ────────────────────────────────────────
# Dentro de docker-compose el host es el nombre del servicio (`postgres`).
# `sslmode=require` si la base está fuera del servidor de la API.
DATABASE_URL="postgresql://ujap_user:CAMBIAR@postgres:5432/ujap_parking_db?schema=public"

# Conexiones del pool por instancia de la API. Debe cumplirse:
#   instancias × DATABASE_POOL_SIZE  <  max_connections de PostgreSQL (100)
DATABASE_POOL_SIZE=25

# ── JWT ──────────────────────────────────────────────────
# Dos secretos DISTINTOS. Si se comparten, un access token robado sirve
# también para renovar y la expiración corta deja de proteger.
JWT_ACCESS_SECRET=CAMBIAR-generar-con-openssl-rand-base64-48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR-otro-distinto-generar-con-openssl
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
# Origen exacto del frontend, con https. Nunca `*`: las peticiones
# van con credenciales.
CORS_ORIGIN=https://parking.ujap.edu.ve

# ── Seguridad ────────────────────────────────────────────
# Intentos de login por CORREO cada 5 minutos (sección 24).
LOGIN_MAX_ATTEMPTS=10
