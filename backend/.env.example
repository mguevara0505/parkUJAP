# ─────────────────────────────────────────────────────────
# UJAP Parking — Variables de Entorno
# Copiar este archivo como .env.development o .env
# NUNCA commitear archivos .env con valores reales
# ─────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development

# Puerto del servidor API
PORT=3001

# Base de datos PostgreSQL
DATABASE_URL="postgresql://ujap_user:ujap_password@localhost:5432/ujap_parking_db?schema=public"

# JWT — Access Token (corta duración)
JWT_ACCESS_SECRET=ujap-parking-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m

# JWT — Refresh Token (larga duración)
JWT_REFRESH_SECRET=ujap-parking-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Origen permitido (URL del frontend)
CORS_ORIGIN=http://localhost:3000
