# ─────────────────────────────────────────────────────────
# UJAP Parking — Variables de docker-compose.prod.yml
#
# Copiar como `.env` EN LA RAÍZ del proyecto, en el servidor, y rellenar.
# `.env` está en .gitignore: no se sube nunca con valores reales.
#
# Generar cada secreto:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────

# ── Dominio ──────────────────────────────────────────────
# Debe apuntar por DNS a este servidor: Caddy pide el certificado por ahí.
# Para probar sin dominio, poner `localhost`.
DOMAIN=parking.ujap.edu.ve

# URL pública de la API, la que usará el navegador. Se incrusta en el
# frontend AL CONSTRUIR, así que si cambia hay que reconstruir la imagen.
PUBLIC_API_URL=https://parking.ujap.edu.ve/api/v1

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=ujap_user
POSTGRES_PASSWORD=CAMBIAR-contraseña-larga-y-aleatoria
POSTGRES_DB=ujap_parking_db

# Conexiones del pool por instancia de la API. Debe cumplirse:
#   instancias × DATABASE_POOL_SIZE  <  max_connections de PostgreSQL (100)
DATABASE_POOL_SIZE=25

# ── JWT ──────────────────────────────────────────────────
# Dos secretos DISTINTOS. Compartirlos convierte un access token robado en
# un refresh token, y la expiración corta deja de servir de nada.
JWT_ACCESS_SECRET=CAMBIAR-openssl-rand-base64-48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR-otro-distinto
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
# Origen exacto, con https. Nunca `*`: las peticiones llevan credenciales.
CORS_ORIGIN=https://parking.ujap.edu.ve

# ── Seguridad ────────────────────────────────────────────
# Intentos de login por CORREO cada 5 minutos (sección 24).
LOGIN_MAX_ATTEMPTS=10
